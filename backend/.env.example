# ── Database ──────────────────────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/oilspill_db

# Azure production (replace with your Flexible Server values):
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com/oilspill_db?sslmode=require

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Azure production (replace with your Static Web App URL):
# CORS_ALLOWED_ORIGINS=https://<name>.azurestaticapps.net

# ── SAR Model ─────────────────────────────────────────────────────────────────
STANDALONE_MODEL_PATH=models/mit_b2_unet_best.pth
SAR_THRESHOLD=0.50
MIN_OIL_AREA_PERCENT=0.50
SAR_MIN_REGION_PIXELS=10
SAR_MAX_UPLOAD_BYTES=26214400

# ── AIS Stream ────────────────────────────────────────────────────────────────
AIS_STREAM_URL=wss://stream.aisstream.io/v0/stream
AIS_API_KEY=your_aisstream_api_key_here
